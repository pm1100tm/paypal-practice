# ==========================================================================
# shopswd-app 환경 변수 템플릿
#  - 이 파일을 복사해 .env 로 만들고 값을 채운 뒤, 쉘에 export 해서 실행합니다.
#  - .env 는 .gitignore 대상입니다. 실제 키를 커밋하지 마세요.
# ==========================================================================

# Server
APP_PORT=8080

# Frontend (shopswd-mobile) 주소 — CORS 허용 및 PayPal return/cancel URL 에 사용
MAIN_MOBILE_PUBLIC_ENDPOINT=http://localhost:3000

# PayPal REST API
#  - Sandbox : https://api-m.sandbox.paypal.com
#  - Live    : https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Checkout 정책 (USD)
CHECKOUT_SHIPPING_FLAT_FEE=0.00
# 비워두면 무료배송 기준 없음
CHECKOUT_SHIPPING_FREE_THRESHOLD=

# MySQL (docker compose) — 로컬 개발용 기본값. 공유 환경에서는 반드시 변경
MYSQL_PORT=3306
MYSQL_DATABASE=shopswd
MYSQL_USER=shopswd
MYSQL_PASSWORD=shopswd
MYSQL_ROOT_PASSWORD=root
