# PayPal JS SDK client-id (서버 런타임에 읽어서 클라이언트에 전달)
#  - 백엔드 PAYPAL_CLIENT_ID 와 같은 REST App 의 Client ID 를 사용해야 합니다.
PAYPAL_CLIENT_ID=
